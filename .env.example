# ---------------------------------------------------------------------------
# Public site config (safe to expose to the browser)
# ---------------------------------------------------------------------------

# Canonical origin. Used for metadataBase, canonical URLs, OG images,
# sitemap.xml and the JSON-LD @id graph. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.thewaterboycafe.com.au

# ---------------------------------------------------------------------------
# Form delivery (server-only — never prefixed with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------

# Where reservation / contact / newsletter submissions are POSTed as JSON.
# Works with Zapier, Make, n8n, Formspree, a Google Apps Script webhook, or
# your own endpoint. If unset, submissions are validated and logged only —
# the form still succeeds, so local development never needs a webhook.
FORM_WEBHOOK_URL=

# Optional shared secret sent as the `X-Webhook-Token` header.
FORM_WEBHOOK_TOKEN=

# Address shown to staff in the webhook payload as the reply-to inbox.
CONTACT_INBOX=Info@thewaterboycafe.com.au

# ---------------------------------------------------------------------------
# Verification (optional)
# ---------------------------------------------------------------------------
GOOGLE_SITE_VERIFICATION=
