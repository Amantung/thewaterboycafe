# ---------------------------------------------------------------------------
# Public site config (safe to expose to the browser)
# ---------------------------------------------------------------------------

# Canonical origin. Used for metadataBase, canonical URLs, OG images,
# sitemap.xml and the JSON-LD @id graph. No trailing slash.
# The apex (no "www") is canonical — next.config.mjs 301-redirects the www
# host onto this one, so this must match or the two will disagree.
NEXT_PUBLIC_SITE_URL=https://thewaterboycafe.com.au

# ---------------------------------------------------------------------------
# Contact form email delivery (server-only — never prefixed with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------

# SMTP credentials used to send the contact form notification email.
# All five are required for real delivery — with any of them unset the
# submission is still validated and logged, but no email is sent, so local
# development never needs real SMTP credentials.

# SMTP server hostname, e.g. smtp.gmail.com or your webmail provider's host.
SMTP_HOST=

# SMTP port. Use 465 for implicit TLS, or 587 for STARTTLS.
SMTP_PORT=587

# SMTP login — the sending mailbox. Should match info@thewaterboycafe.com.au.
SMTP_USER=

# SMTP password — an App Password for info@thewaterboycafe.com.au, not the
# account's normal login password (required by Gmail/Google Workspace and
# most providers when using SMTP directly).
SMTP_PASS=

# Where every contact form notification is sent.
TO_EMAIL=info@thewaterboycafe.com.au

# ---------------------------------------------------------------------------
# Newsletter form delivery (server-only)
# ---------------------------------------------------------------------------

# Where newsletter signups are POSTed as JSON. Works with Zapier, Make, n8n,
# Formspree, a Google Apps Script webhook, or your own endpoint. If unset,
# submissions are validated and logged only — the form still succeeds, so
# local development never needs a webhook.
FORM_WEBHOOK_URL=

# Optional shared secret sent as the `X-Webhook-Token` header.
FORM_WEBHOOK_TOKEN=

# Address shown to staff in the webhook payload as the reply-to inbox.
CONTACT_INBOX=Info@thewaterboycafe.com.au

# ---------------------------------------------------------------------------
# Verification (optional)
# ---------------------------------------------------------------------------
GOOGLE_SITE_VERIFICATION=
